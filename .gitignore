# Skills ship with the repo — both Claude Code (.claude/skills) and OpenClaw
# (skills/rosclaw-wiki) variants. .claude/skills/ is tracked by default; the
# anchored /skills/ rule below only blocks stray top-level skills directories.
/skills/*
!/skills/rosclaw-wiki/
!/skills/rosclaw-wiki/**

# Tests & Reports (not for release)
test_*.py
test_awesome.md
TEST_*.md
PHASE*_REPORT*.md
PHASE_*_CLOSED
*_COMPLETE_STATUS_REPORT.md
compare_fulltext_abstract.py
test_real_ingest.py

# Docs (dev-only — only the listed files ship publicly)
docs/*
docs/**/
!docs/DEPLOY.md
!docs/ADMIN_BATCH_SYNC.md
!docs/ENVIRONMENT.md
!docs/TUTORIAL_AWESOME_INGEST.md
!docs/api_spec_v1.json

# Generated artifacts
awesome_vln*.yml
awesome_vln*.json

# Claude Flow
.claude-flow/

# Testing
.pytest_cache/

# Temporary
tmp/
temp/
*.tmp
data/code_graph.json
data/code_graph_external.json
seekdb.db/
*.db

# Wiki pages are runtime data (merged via batch_sync) — keep only catalog + log
wiki/**/*.md
!wiki/index.md
!wiki/log.md
