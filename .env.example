# ROSClaw Wiki — Environment Variables
# Copy this file to .env and fill in actual values

# LLM APIs (configure at least one for local knowledge forging)
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...

# PaddleOCR (optional, for complex PDF parsing)
PADDLEOCR_API_URL=https://your-paddleocr-endpoint/layout-parsing
PADDLEOCR_API_TOKEN=your-token

# ROSClaw Cloud API Key (for push to api.rosclaw.io)
ROSCLAW_API_KEY=rw_sk_...

# Server-side only (users don't need these locally)
# SEEKDB_MODE=server
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=rosclaw-wiki
